# דוגמה בלבד — אין כאן ערכים אמיתיים. את הערך האמיתי שמים ב-.env.local (מקומי, לא ב-git)
# וב-Vercel: Project → Settings → Environment Variables.
# הכתובת מנאון: Console → הפרויקט → Connect → Connection string (בחרו "Pooled connection").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
